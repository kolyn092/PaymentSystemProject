# 최상위 설정
root = true

# 모든 파일 기본 설정
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java
[*.java]
indent_size = 4

# Kotlin
[*.{kt,kts}]
indent_size = 4

# XML, YAML
[*.{xml,yaml,yml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Gradle
[*.gradle]
indent_size = 4

# Windows 배치 파일 (예외)
[*.{bat,cmd}]
end_of_line = crlf